<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Name="Workspace" Background="#F4F6F9" TextElement.Foreground="#182434"
      TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.FontSize="13">
  <Grid.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#29394D"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9E1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#779CF5"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".78"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#265CDB"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".48"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="Foreground" Value="#596C81"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE3EB"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="20,20,20,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="346"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="37"/><RowDefinition/><RowDefinition Height="43"/></Grid.RowDefinitions>
        <Grid Margin="18,0,16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="文件预览" Style="{StaticResource Heading}"/>
            <TextBlock Name="Total" Text="0" FontFamily="Segoe UI" FontSize="14" Foreground="#637385" Margin="10,3,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Name="AddFiles" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="添加文件" ToolTip="添加文件 (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontFamily="Segoe UI" FontSize="17" Margin="0,-2,6,0"/><TextBlock Text="添加文件"/></StackPanel>
          </Button>
        </Grid>
        <Border Grid.Row="1" Background="#F6F8FB" BorderBrush="#E5EAF0" BorderThickness="0,1">
          <Grid Margin="16,0,15,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
            <CheckBox Name="SelectAll" VerticalAlignment="Center" AutomationProperties.Name="全选文件" ToolTip="全选文件"/>
            <Button Name="Sort" Grid.Column="1" HorizontalAlignment="Left" Padding="0,1,4,1" MinHeight="22" FontSize="12" Style="{StaticResource QuietButton}" ToolTip="按原文件名排序，编号随列表顺序更新">原文件名 ↕</Button>
            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="#586B80" Text="新文件名"/>
          </Grid>
        </Border>
        <ListBox Grid.Row="2" Name="Files" BorderThickness="0" Padding="0" SelectionMode="Extended"
                 Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="文件预览列表">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#EEF1F5">
                  <ContentPresenter HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F6F9FF"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF3FF"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="16,0,15,0" MinHeight="49">
                <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Included,Mode=TwoWay}" AutomationProperties.Name="{Binding Original}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Original}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis" Foreground="#596C81"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Text="→" Foreground="#8091A4"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,6,2,6">
                  <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview}">
                    <TextBlock.Style><Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#5F6D7D"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Changed}" Value="True"><Setter Property="Foreground" Value="#164BAF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Problem}" Foreground="#AE321F" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                      <DataTrigger Binding="{Binding Problem}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="4" Name="EditName" VerticalAlignment="Center" MinHeight="26" Padding="4" Style="{StaticResource QuietButton}"
                        ToolTip="单独编辑此名称 (F2)" AutomationProperties.Name="编辑文件名">
                  <Path Stroke="#74859A" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M 2,9 L 9,2 12,5 5,12 1,13 Z M 8,3 L 11,6"/>
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="6">
          <Border Width="62" Height="62" Background="#EAF0FF" CornerRadius="17" HorizontalAlignment="Center">
            <Viewbox Width="32" Height="32"><Canvas Width="32" Height="32">
              <Path Data="M 8,4 L 19,4 25,10 25,27 8,27 Z" Fill="White" Stroke="#3E6EDB" StrokeThickness="1.8" StrokeLineJoin="Round"/>
              <Path Data="M 19,4 V 10 H 25 M 12,15 H 21 M 12,19 H 18" Stroke="#3E6EDB" StrokeThickness="1.6" StrokeLineJoin="Round"/>
            </Canvas></Viewbox>
          </Border>
          <TextBlock Text="将文件拖到这里" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
          <TextBlock Text="也可以点击“添加文件”或在资源管理器中右键打开" TextAlignment="Center" TextWrapping="Wrap" Foreground="#637385" FontSize="12" Margin="0,7,0,0"/>
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="#E5EAF0" BorderThickness="0,1,0,0" Padding="16,0,11,0">
          <DockPanel LastChildFill="True">
            <Button Name="Clear" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" ToolTip="从预览中移除所有文件">清空列表</Button>
            <TextBlock Name="Counts" VerticalAlignment="Center" FontSize="12" Foreground="#637385" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Card}">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Height="68" Padding="18,0" BorderThickness="0,0,0,1" BorderBrush="#E5EAF0">
          <TextBlock Text="命名规则" Style="{StaticResource Heading}"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,16,16,12">
          <ContentControl Name="RuleHost" HorizontalContentAlignment="Stretch"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="22,14">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="保存方式" FontSize="12" Foreground="#637385" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <RadioButton Name="RenameMode" Content="原地重命名" IsChecked="True" GroupName="SaveMode" Margin="0,0,15,0" VerticalContentAlignment="Center"/>
        <RadioButton Name="CopyMode" Content="另存为副本" GroupName="SaveMode" VerticalContentAlignment="Center" ToolTip="在原文件所在文件夹创建新名称的副本"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Name="Notice" Margin="14,0,8,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#42674C"/>
      <Button Grid.Column="2" Name="Undo" Content="撤销上次操作" Margin="0,0,10,0" ToolTip="撤销本窗口的上一次操作 (Ctrl+Z)"/>
      <Button Grid.Column="3" Name="Apply" Background="#265CDB" Foreground="White" BorderBrush="#265CDB" FontWeight="SemiBold" Width="120" MinHeight="37" Content="重命名"/>
    </Grid>
  </Border>
</Grid>
